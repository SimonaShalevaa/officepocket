{
  "expo": {
    "name": "OfficePocket",
    "slug": "OfficePocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "OfficePocket използва камерата, за да снимате фактури, бележки и договори.",
          "photosPermission": "OfficePocket използва галерията, за да прикачите снимка на документ."
        }
      ],
      "expo-secure-store"
    ]
  }
}
