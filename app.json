{
  "expo": {
    "name": "OfficePocket",
    "slug": "officepocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6F5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.simonashaleva.officepocket"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "OfficePocket използва камерата, за да снимате фактури, бележки и договори.",
          "photosPermission": "OfficePocket използва галерията, за да прикачите снимка на документ.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#1F6F5C"
              }
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#1F6F5C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121614"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e2b12fbb-1268-439b-9c4f-4d141f0fac1b"
      }
    }
  }
}
